# ============================================================
#  Educa360 Backend - Plantilla de variables de entorno
# ------------------------------------------------------------
#  Cómo usarla (cualquiera que clonne el repo):
#     1) cp .env.example .env
#     2) rellena los valores marcados con <...> y guarda
#     3) docker compose up -d
#
#  El archivo .env está en .gitignore: NUNCA se sube a Git.
#  Este .env.example sí se versiona, pero sin secretos reales.
# ============================================================

# ---------- Base de datos (PostgreSQL en Docker) ----------
POSTGRES_DB=educa360
POSTGRES_USER=postgres
# Cámbiala por algo propio (sólo es "débil" si la BD queda expuesta)
POSTGRES_PASSWORD=<tu-contraseña-de-postgres>

# Puertos del host. Postgres se publica SÓLO en 127.0.0.1
# (ver docker-compose.yml): no es accesible desde la red local.
POSTGRES_PORT=5432
BACKEND_PORT=8080

# ---------- JWT ----------
# OBLIGATORIO: el contenedor no arranca sin él.
# Genera el tuyo (mínimo 32 bytes):   openssl rand -base64 48
APP_JWT_SECRET=<genera-una-clave-de-al-menos-32-bytes>

# Validez del token en milisegundos (24 h por defecto)
APP_JWT_EXPIRATION_MS=86400000

# ---------- CORS ----------
# Desarrollo: "*" deja pasar a http://localhost:5173 (Vite), 3000 (React) o 4200 (Angular).
# Producción: lista explícita de orígenes, separados por coma.
APP_CORS_ALLOWED_ORIGINS=*

# ---------- Límite de intentos de login (anti fuerza bruta) ----------
# 5 fallos dentro de 15 min -> bloqueo de 15 min (429 + Retry-After).
# OJO con los nombres: son la propiedad de Spring con "." -> "_" en mayúsculas
# (app.security.login.max-attempts -> APP_SECURITY_LOGIN_MAX_ATTEMPTS);
# un nombre que no coincide se ignora EN SILENCIO y se queda en el valor por defecto.
APP_SECURITY_LOGIN_MAX_ATTEMPTS=5
APP_SECURITY_LOGIN_WINDOW_MINUTES=15
APP_SECURITY_LOGIN_COOLDOWN_MINUTES=15
